version: v1.25.0
ignore:
  SNYK-JS-URIJS-19963963:
    - '*':
        reason: >
          uri-js@4.4.1, pulled in by ajv@6.14.0 (a direct dependency, used
          in questionnaire/questionnaire-service.js for real schema
          validation). uri-js@4.4.1 is the newest version published at
          all — there is no patched release to upgrade to within ajv@6's
          declared range (^4.2.2). The only real fix is moving ajv to
          v8.x, which removes the uri-js dependency entirely (ajv@8 uses
          fast-uri instead), but that's a major-version jump with known
          breaking API changes, and two plugins depend on ajv's shape
          here: ajv-errors@1.0.1 (loose, unverified peer range) and
          ajv-formats-mobile-uk (a custom in-house plugin from a separate
          repo, github:CriminalInjuriesCompensationAuthority/ajv-formats-mobile-uk,
          whose own ajv@8 compatibility hasn't been checked). Tracked as
          a separate piece of work rather than folded into this migration.
          See backlog ticket for the ajv v8 migration. (CAPP-209)
        expires: '2026-11-23T00:00:00.000Z'
  SNYK-JS-UNDICI-19635210:
    - '*':
        reason: >
          Vulnerable undici@6.28.0 pinned by npm's bundled node-gyp
          dependency (npm@11.19.1 > node-gyp@12.4.0 > undici@6.28.0).
          Build-time tool only (node-gyp compiles native modules during
          install), not present in the running application's request path.
          Fixed in 6.28.1/7.29.1/8.10.2, but the version bundled by npm
          isn't independently controllable without patching npm's tree.
          Note: SNYK-JS-BRACEEXPANSION-18313044/18512280, previously
          ignored here, are confirmed resolved now that npm bumped from
          11.18.0 to 11.19.1 — removed from this file rather than left as
          dead entries. Recheck when npm bumps its bundled undici.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-UNDICI-19635226:
    - '*':
        reason: >
          Same root cause and dependency path as SNYK-JS-UNDICI-19635210 —
          npm's bundled node-gyp/undici@6.28.0, build-time only, no fix
          currently available upstream without patching npm's tree.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-UNDICI-21181005:
    - '*':
        reason: >
          Same root cause and dependency path as SNYK-JS-UNDICI-19635210 —
          npm's bundled node-gyp/undici@6.28.0, build-time only. Fixed in
          6.29.1/7.30.1/8.12.2, not independently controllable without
          patching npm's tree. Critical severity per Snyk, but never
          exercised by the running application (app scan clean, 306
          dependencies tested). Recheck when npm bumps its bundled
          node-gyp/undici.
        expires: '2026-11-09T00:00:00.000Z'
  SNYK-JS-UNDICI-21181013:
    - '*':
        reason: >
          Same root cause and dependency path as SNYK-JS-UNDICI-19635210 —
          npm's bundled node-gyp/undici@6.28.0, build-time only, no fix
          currently available upstream without patching npm's tree.
        expires: '2026-11-09T00:00:00.000Z'
