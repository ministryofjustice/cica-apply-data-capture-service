version: v1.25.0
ignore:
  SNYK-JS-BRACEEXPANSION-16755174:
    - '*':
        reason: >
          Vulnerability in npm's bundled brace-expansion. Not present in
          application dependencies. No fix available for npm 11.x on Node 24 LTS.
          Will resolve on next Node LTS upgrade.
        expires: '2026-08-20T00:00:00.000Z'
  SNYK-JS-UNDICI-17372658:
    - '*':
        reason: >
          Vulnerable undici version pinned by npm's bundled node-gyp
          dependency (node-gyp@12.x and 13.0.0 all declare undici@^6.25.0).
          Tested npm 11.13.0 / 11.14.0 / 11.16.0 / 11.17.0 — all resolve to
          a vulnerable undici version. Build-time tool only (node-gyp
          compiles native modules during install), not present in the
          running application's request path. No fix available until
          node-gyp bumps its undici dependency.
        expires: '2026-08-20T00:00:00.000Z'
  SNYK-JS-UNDICI-17372754:
    - '*':
        reason: >
          Same root cause as SNYK-JS-UNDICI-17372658 — vulnerable undici
          pinned via npm's bundled node-gyp dependency, build-time only,
          no fix currently available upstream.
        expires: '2026-08-20T00:00:00.000Z'
  SNYK-JS-UNDICI-17372758:
    - '*':
        reason: >
          Same root cause as SNYK-JS-UNDICI-17372658 — vulnerable undici
          pinned via npm's bundled node-gyp dependency, build-time only,
          no fix currently available upstream.
        expires: '2026-08-20T00:00:00.000Z'
  SNYK-JS-URIJS-19963963:
    - '*':
        reason: >
          uri-js@4.4.1, pulled in by ajv@6.14.0 (a direct dependency, used
          in questionnaire/questionnaire-service.js for real schema
          validation). uri-js@4.4.1 is the newest version published at
          all — there is no patched release to upgrade to within ajv@6's
          declared range (^4.2.2). The only real fix is moving ajv to
          v8.x, which removes the uri-js dependency entirely (ajv@8 uses
          fast-uri instead), but that's a major-version jump with known
          breaking API changes, and two plugins depend on ajv's shape
          here: ajv-errors@1.0.1 (loose, unverified peer range) and
          ajv-formats-mobile-uk (a custom in-house plugin from a separate
          repo, github:CriminalInjuriesCompensationAuthority/ajv-formats-mobile-uk,
          whose own ajv@8 compatibility hasn't been checked). Tracked as
          a separate piece of work rather than folded into this migration.
          See backlog ticket for the ajv v8 migration. (CAPP-209)
        expires: '2026-11-23T00:00:00.000Z'